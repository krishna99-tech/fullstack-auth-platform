<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Verify your email — {{appName}}</title>
<style>
  @media screen and (max-width: 600px) {
    .content-cell { padding: 24px 20px !important; }
    .header-cell, .footer-cell { padding: 20px !important; }
    h1 { font-size: 22px !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background-color:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f5f7;padding:48px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.06),0 1px 4px rgba(0,0,0,0.04);">

          <!-- Header - Clean, minimal, no color -->
          <tr>
            <td class="header-cell" style="background:#ffffff;padding:32px 40px 24px;text-align:center;border-bottom:1px solid #e8eaed;">
              {{#if logoUrl}}
              <img src="{{logoUrl}}" alt="{{appName}}" width="40" style="display:block;margin:0 auto 10px;">
              {{/if}}
              <span style="color:#202124;font-size:18px;font-weight:500;letter-spacing:-0.2px;">{{appName}}</span>
            </td>
          </tr>

          <!-- Body - Professional, clean -->
          <tr>
            <td class="content-cell" style="padding:40px 48px 32px;">

              <!-- Heading -->
              <h1 style="margin:0 0 12px;font-size:24px;color:#202124;font-weight:500;letter-spacing:-0.3px;text-align:center;">
                Confirm your email address
              </h1>
              
              <p style="margin:0 0 28px;font-size:15px;line-height:1.6;color:#5f6368;text-align:center;">
                Hi <span style="color:#202124;font-weight:500;">{{userName}}</span>, please confirm this is your email address to finish setting up your {{appName}} account.
              </p>

              <!-- Verification Code - Professional display -->
              {{#if verificationCode}}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 16px;">
                <tr>
                  <td align="center" style="background:#f8f9fa;border-radius:8px;padding:20px;border:1px solid #e8eaed;">
                    <span style="font-size:32px;font-weight:500;letter-spacing:8px;color:#202124;font-family:'SF Mono',Menlo,Consolas,monospace;">{{verificationCode}}</span>
                  </td>
                </tr>
              </table>
              <p style="margin:0 0 28px;font-size:14px;color:#5f6368;text-align:center;">
                Enter this code in the app to verify your email
              </p>
              {{/if}}

              <!-- OR Divider -->
              {{#if verificationCode}}{{#if verificationLink}}
              <div style="text-align:center;margin:0 0 24px;">
                <span style="background:#ffffff;padding:0 12px;font-size:12px;color:#9aa0a6;text-transform:uppercase;letter-spacing:0.5px;">or</span>
                <div style="height:1px;background:#e8eaed;margin-top:-8px;"></div>
              </div>
              {{/if}}{{/if}}

              <!-- Verification Link - Professional button only -->
              {{#if verificationLink}}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 12px;">
                <tr>
                  <td align="center">
                    <a href="{{verificationLink}}" style="display:inline-block;width:100%;padding:12px 0;font-size:15px;font-weight:500;color:#ffffff;text-decoration:none;border-radius:6px;background:#1a73e8;text-align:center;border:1px solid #1a73e8;transition:background 0.2s;">
                      Verify Email Address
                    </a>
                  </td>
                </tr>
              </table>
              {{/if}}

              <!-- Divider -->
              <div style="margin:32px 0 20px;height:1px;background:#e8eaed;"></div>

              <!-- Expiry & Security info -->
              <div style="text-align:center;">
                <p style="margin:0 0 4px;font-size:13px;color:#5f6368;line-height:1.6;">
                  This {{#if verificationCode}}code{{else}}link{{/if}} expires in <span style="color:#202124;font-weight:500;">{{expiryMinutes}} minutes</span>
                </p>
                <p style="margin:0;font-size:13px;color:#9aa0a6;line-height:1.6;">
                  If you didn't create an account with {{appName}}, you can safely ignore this email.
                </p>
              </div>

            </td>
          </tr>

          <!-- Footer - Clean, professional -->
          <tr>
            <td class="footer-cell" style="background:#f8f9fa;padding:24px 40px;text-align:center;border-top:1px solid #e8eaed;">
              <p style="margin:0 0 4px;font-size:12px;color:#9aa0a6;">
                &copy; {{year}} {{appName}}. All rights reserved.
              </p>
              <p style="margin:0 0 4px;font-size:12px;color:#9aa0a6;">
                <a href="#" style="color:#5f6368;text-decoration:none;">Privacy Policy</a>
                <span style="margin:0 6px;color:#dadce0;">·</span>
                <a href="#" style="color:#5f6368;text-decoration:none;">Terms of Service</a>
              </p>
              <p style="margin:8px 0 0;font-size:12px;color:#9aa0a6;">
                Need help? Contact <a href="mailto:{{supportEmail}}" style="color:#1a73e8;text-decoration:none;">{{supportEmail}}</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>