<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Welcome to {{appName}}</title>
<style>
  @media screen and (max-width: 600px) {
    .content-cell { padding: 24px 20px !important; }
    .header-cell, .footer-cell { padding: 20px !important; }
    h1 { font-size: 22px !important; }
  }
</style>
</head>
<body style="margin:0;padding:0;background-color:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#ffffff;padding:48px 0;">
    <tr>
      <td align="center">
        <!-- Outer container with subtle premium shadow -->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background-color:#ffffff;overflow:hidden;">

          <!-- Header - Minimalist, premium -->
          <tr>
            <td class="header-cell" style="background:#ffffff;padding:36px 48px 24px;text-align:center;border-bottom:1px solid #f0f1f3;">
              {{#if logoUrl}}
              <img src="{{logoUrl}}" alt="{{appName}}" width="44" style="display:block;margin:0 auto 10px;border-radius:12px;">
              {{/if}}
              <span style="color:#1a1a1a;font-size:18px;font-weight:600;letter-spacing:-0.2px;font-family:'SF Pro Display',-apple-system,BlinkMacSystemFont,sans-serif;">{{appName}}</span>
              <div style="margin-top:10px;height:3px;width:32px;background:linear-gradient(90deg,#4f46e5,#7c3aed);border-radius:4px;margin-left:auto;margin-right:auto;"></div>
            </td>
          </tr>

          <!-- Body - Premium, spacious, refined -->
          <tr>
            <td class="content-cell" style="padding:44px 48px 36px;">

              <!-- Premium greeting -->
              <div style="margin-bottom:28px;">
                <span style="font-size:38px;line-height:1.2;display:block;margin-bottom:6px;">👋</span>
                <h1 style="margin:0;font-size:28px;color:#111827;font-weight:600;letter-spacing:-0.5px;font-family:'SF Pro Display',-apple-system,BlinkMacSystemFont,sans-serif;">
                  Welcome, {{userName}}
                </h1>
                <p style="margin:6px 0 0;font-size:17px;color:#6b7280;font-weight:400;letter-spacing:-0.2px;">
                  You're now part of the {{appName}} community
                </p>
              </div>

              <!-- Main message -->
              <p style="margin:0 0 28px;font-size:16px;line-height:1.7;color:#374151;">
                Thanks for creating your account. We're thrilled to have you on board.
              </p>

              <!-- Verification - Premium card design -->
              {{#if verificationLink}}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 32px;border:1px solid #e5e7eb;background-color:#fafbfc;border-radius:12px;">
                <tr>
                  <td style="padding:24px 28px 20px;">
                    <div style="display:flex;align-items:flex-start;gap:14px;margin-bottom:18px;">
                      <div style="background:#eef2ff;border-radius:8px;padding:8px;width:40px;height:40px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <span style="font-size:20px;">✉️</span>
                      </div>
                      <div>
                        <p style="margin:0 0 4px;font-size:15px;font-weight:600;color:#111827;letter-spacing:-0.2px;">Verify your email</p>
                        <p style="margin:0;font-size:14px;color:#6b7280;line-height:1.5;">
                          Confirm your email address to unlock all features
                        </p>
                      </div>
                    </div>
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td align="center" style="padding-top:4px;">
                          <a href="{{verificationLink}}" style="display:inline-block;width:100%;padding:14px 0;font-size:15px;font-weight:500;color:#ffffff;text-decoration:none;border-radius:8px;background:#4f46e5;text-align:center;border:1px solid #4f46e5;letter-spacing:-0.1px;box-shadow:0 2px 8px rgba(79,70,229,0.15);transition:all 0.2s;">
                            Verify Email Address →
                          </a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
              {{/if}}

              <!-- Premium divider -->
              <div style="margin:0 0 28px;height:1px;background:linear-gradient(90deg,transparent,#e5e7eb,transparent);"></div>

              <!-- Simple, clean support section -->
              <div style="margin:0 0 8px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td style="padding:0 0 8px 0;width:100%;vertical-align:top;">
                      <div style="background:#fafbfc;border-radius:10px;padding:16px 20px;border:1px solid #f0f1f3;">
                        <p style="margin:0;font-size:14px;color:#6b7280;line-height:1.6;text-align:center;">
                          <span style="font-weight:500;color:#111827;">Questions?</span> 
                          We're here to help. Reach us at 
                          <a href="mailto:{{supportEmail}}" style="color:#4f46e5;text-decoration:none;font-weight:500;">{{supportEmail}}</a>
                        </p>
                      </div>
                    </td>
                  </tr>
                </table>
              </div>

            </td>
          </tr>

          <!-- Footer - Ultra premium -->
          <tr>
            <td class="footer-cell" style="background:#fafbfc;padding:28px 48px 24px;text-align:center;border-top:1px solid #f0f1f3;">
              <p style="margin:0 0 6px;font-size:13px;color:#9ca3af;letter-spacing:0.2px;">
                &copy; {{year}} {{appName}}. All rights reserved.
              </p>
              <p style="margin:0 0 6px;font-size:13px;color:#9ca3af;">
                <a href="#" style="color:#9ca3af;text-decoration:none;transition:color 0.2s;">Privacy Policy</a>
                <span style="margin:0 8px;color:#d1d5db;">·</span>
                <a href="#" style="color:#9ca3af;text-decoration:none;transition:color 0.2s;">Terms of Service</a>
                <span style="margin:0 8px;color:#d1d5db;">·</span>
                <a href="#" style="color:#9ca3af;text-decoration:none;transition:color 0.2s;">Security</a>
              </p>
              {{#if unsubscribeLink}}
              <p style="margin:10px 0 0;font-size:13px;color:#9ca3af;">
                <a href="{{unsubscribeLink}}" style="color:#9ca3af;text-decoration:none;border-bottom:1px dotted #d1d5db;transition:border-color 0.2s;">Unsubscribe from updates</a>
              </p>
              {{/if}}
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>