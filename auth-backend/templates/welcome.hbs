<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Welcome to Auth Platform</title>
</head>
<body style="margin:0;padding:0;background-color:#0a0a0a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#0a0a0a;padding:40px 16px;">
    <tr><td align="center">
      <table width="100%" style="max-width:560px;" cellpadding="0" cellspacing="0">

        <!-- Logo -->
        <tr><td style="padding-bottom:28px;">
          <table cellpadding="0" cellspacing="0"><tr>
            <td style="background:linear-gradient(135deg,#7c3aed,#4f46e5);border-radius:10px;width:36px;height:36px;text-align:center;vertical-align:middle;font-size:18px;">🔐</td>
            <td style="padding-left:10px;font-size:15px;font-weight:700;color:#ffffff;vertical-align:middle;">Auth Platform</td>
          </tr></table>
        </td></tr>

        <!-- Card -->
        <tr><td style="background:#111111;border-radius:16px;border:1px solid #222222;overflow:hidden;">
          <table width="100%" cellpadding="0" cellspacing="0">
            <tr><td style="padding:40px 36px 0;text-align:center;">

              <!-- Checkmark Icon -->
              <div style="width:64px;height:64px;background:rgba(16,185,129,0.12);border-radius:16px;text-align:center;line-height:64px;font-size:32px;margin:0 auto 24px;">✅</div>

              <h1 style="margin:0 0 12px;font-size:22px;font-weight:700;color:#ffffff;">You're verified!</h1>
              <p style="margin:0 0 28px;font-size:15px;color:#a1a1aa;line-height:1.6;">Hi {{name}}, your email has been successfully verified. We're thrilled to have you on board.</p>
              <p style="margin:0 0 32px;font-size:15px;color:#a1a1aa;line-height:1.6;">You can now log in and start using all the features of the platform.</p>

              <!-- CTA Button -->
              <a href="{{loginLink}}" style="display:inline-block;background:linear-gradient(135deg,#7c3aed,#4f46e5);color:#ffffff;text-decoration:none;padding:13px 32px;border-radius:10px;font-size:15px;font-weight:600;margin-bottom:40px;">Get Started →</a>

              <p style="margin:0 0 36px;font-size:14px;color:#52525b;text-align:left;">Thanks,<br/>The team</p>
            </td></tr>

            <!-- Divider -->
            <tr><td style="border-top:1px solid #1f1f1f;padding:24px 36px;">
              <p style="margin:0;font-size:12px;color:#3f3f46;line-height:1.7;">
                This email was sent to <a href="mailto:{{email}}" style="color:#7c3aed;text-decoration:underline;">{{email}}</a>. If you'd rather not receive this kind of email, you can <a href="#" style="color:#7c3aed;text-decoration:underline;">unsubscribe</a> or <a href="#" style="color:#7c3aed;text-decoration:underline;">manage your email preferences</a>.
              </p>
              <p style="margin:12px 0 0;font-size:12px;color:#3f3f46;">© 2027 Auth Platform</p>
            </td></tr>
          </table>
        </td></tr>

        <!-- Footer -->
        <tr><td style="padding:24px 0;">
          <table width="100%" cellpadding="0" cellspacing="0"><tr>
            <td>
              <table cellpadding="0" cellspacing="0"><tr>
                <td style="background:linear-gradient(135deg,#7c3aed,#4f46e5);border-radius:8px;width:28px;height:28px;text-align:center;vertical-align:middle;font-size:14px;">🔐</td>
                <td style="padding-left:8px;font-size:13px;font-weight:600;color:#52525b;vertical-align:middle;">Auth Platform</td>
              </tr></table>
            </td>
            <td align="right">
              <a href="#" style="margin-left:12px;color:#52525b;text-decoration:none;font-size:13px;font-weight:600;">𝕏</a>
              <a href="#" style="margin-left:12px;color:#52525b;text-decoration:none;font-size:13px;font-weight:600;">f</a>
              <a href="#" style="margin-left:12px;color:#52525b;text-decoration:none;font-size:13px;font-weight:600;">◎</a>
            </td>
          </tr></table>
        </td></tr>

      </table>
    </td></tr>
  </table>
</body>
</html>
