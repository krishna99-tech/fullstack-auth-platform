<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Security Alert</title>
</head>
<body style="margin:0;padding:0;background-color:#0a0a0a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#0a0a0a;padding:40px 16px;">
    <tr><td align="center">
      <table width="100%" style="max-width:560px;" cellpadding="0" cellspacing="0">

        <!-- Logo -->
        <tr><td style="padding-bottom:28px;">
          <table cellpadding="0" cellspacing="0"><tr>
            <td style="background:linear-gradient(135deg,#7c3aed,#4f46e5);border-radius:10px;width:36px;height:36px;text-align:center;vertical-align:middle;font-size:18px;">🔐</td>
            <td style="padding-left:10px;font-size:15px;font-weight:700;color:#ffffff;vertical-align:middle;">Auth Platform</td>
          </tr></table>
        </td></tr>

        <!-- Card -->
        <tr><td style="background:#111111;border-radius:16px;border:1px solid #222222;overflow:hidden;">
          <table width="100%" cellpadding="0" cellspacing="0">
            <tr><td style="padding:36px 36px 0;">

              <p style="margin:0 0 8px;font-size:15px;color:#a1a1aa;">Hi there,</p>
              <p style="margin:0 0 24px;font-size:15px;color:#a1a1aa;line-height:1.6;">We detected a new sign-in to your account. Here are the details:</p>

              <!-- Info Card -->
              <table width="100%" cellpadding="0" cellspacing="0" style="background:#161616;border:1px solid #222;border-radius:12px;margin-bottom:24px;">

                <!-- Time -->
                <tr><td style="padding:16px 20px;border-bottom:1px solid #1f1f1f;">
                  <table cellpadding="0" cellspacing="0"><tr>
                    <td style="font-size:20px;width:32px;vertical-align:top;padding-top:2px;">🕐</td>
                    <td style="padding-left:12px;">
                      <div style="font-size:11px;text-transform:uppercase;letter-spacing:0.8px;color:#52525b;font-weight:600;margin-bottom:4px;">Time</div>
                      <div style="font-size:14px;color:#e4e4e7;font-weight:500;">{{loginTime}}</div>
                    </td>
                  </tr></table>
                </td></tr>

                <!-- Location -->
                <tr><td style="padding:16px 20px;border-bottom:1px solid #1f1f1f;">
                  <table cellpadding="0" cellspacing="0"><tr>
                    <td style="font-size:20px;width:32px;vertical-align:top;padding-top:2px;">📍</td>
                    <td style="padding-left:12px;">
                      <div style="font-size:11px;text-transform:uppercase;letter-spacing:0.8px;color:#52525b;font-weight:600;margin-bottom:4px;">Location</div>
                      <div style="font-size:14px;color:#e4e4e7;font-weight:500;">{{location}}</div>
                    </td>
                  </tr></table>
                </td></tr>

                <!-- IP Address -->
                <tr><td style="padding:16px 20px;{{#if via2FA}}border-bottom:1px solid #1f1f1f;{{/if}}">
                  <table cellpadding="0" cellspacing="0"><tr>
                    <td style="font-size:20px;width:32px;vertical-align:top;padding-top:2px;">🌐</td>
                    <td style="padding-left:12px;">
                      <div style="font-size:11px;text-transform:uppercase;letter-spacing:0.8px;color:#52525b;font-weight:600;margin-bottom:4px;">IP Address</div>
                      <div style="font-size:14px;color:#e4e4e7;font-weight:500;font-family:monospace;">{{ipAddress}}</div>
                    </td>
                  </tr></table>
                </td></tr>

                <!-- 2FA Method (conditional) -->
                {{#if via2FA}}
                <tr><td style="padding:16px 20px;">
                  <table cellpadding="0" cellspacing="0"><tr>
                    <td style="font-size:20px;width:32px;vertical-align:top;padding-top:2px;">🔑</td>
                    <td style="padding-left:12px;">
                      <div style="font-size:11px;text-transform:uppercase;letter-spacing:0.8px;color:#52525b;font-weight:600;margin-bottom:4px;">Method</div>
                      <div style="font-size:14px;color:#e4e4e7;font-weight:500;">Two-Factor Authentication (2FA)</div>
                    </td>
                  </tr></table>
                </td></tr>
                {{/if}}

              </table>

              <!-- Alert Note -->
              {{#if alertMessage}}
              <div style="background:rgba(59,130,246,0.08);border:1px solid rgba(59,130,246,0.2);border-radius:10px;padding:14px 18px;margin-bottom:28px;">
                <p style="margin:0;font-size:13px;color:#93c5fd;line-height:1.6;">ℹ️ {{alertMessage}}</p>
              </div>
              {{else}}
              <div style="background:rgba(239,68,68,0.07);border:1px solid rgba(239,68,68,0.2);border-radius:10px;padding:14px 18px;margin-bottom:28px;">
                <p style="margin:0;font-size:13px;color:#fca5a5;line-height:1.6;">⚠️ If this wasn't you, please visit your Security Settings immediately and revoke this session. We also recommend changing your password.</p>
              </div>
              {{/if}}

              <!-- CTA Button -->
              <a href="{{actionLink}}" style="display:inline-block;background:linear-gradient(135deg,#7c3aed,#4f46e5);color:#ffffff;text-decoration:none;padding:13px 28px;border-radius:10px;font-size:15px;font-weight:600;margin-bottom:36px;">Review Active Sessions →</a>

              <p style="margin:0 0 36px;font-size:14px;color:#52525b;">Thanks,<br/>The team</p>
            </td></tr>

            <!-- Divider -->
            <tr><td style="border-top:1px solid #1f1f1f;padding:24px 36px;">
              <p style="margin:0;font-size:12px;color:#3f3f46;line-height:1.7;">
                This email was sent to <a href="#" style="color:#7c3aed;text-decoration:underline;">your account email</a>. If you'd rather not receive this kind of email, you can <a href="#" style="color:#7c3aed;text-decoration:underline;">unsubscribe</a> or <a href="#" style="color:#7c3aed;text-decoration:underline;">manage your email preferences</a>.
              </p>
              <p style="margin:12px 0 0;font-size:12px;color:#3f3f46;">© 2027 Auth Platform</p>
            </td></tr>
          </table>
        </td></tr>

        <!-- Footer -->
        <tr><td style="padding:24px 0;">
          <table width="100%" cellpadding="0" cellspacing="0"><tr>
            <td>
              <table cellpadding="0" cellspacing="0"><tr>
                <td style="background:linear-gradient(135deg,#7c3aed,#4f46e5);border-radius:8px;width:28px;height:28px;text-align:center;vertical-align:middle;font-size:14px;">🔐</td>
                <td style="padding-left:8px;font-size:13px;font-weight:600;color:#52525b;vertical-align:middle;">Auth Platform</td>
              </tr></table>
            </td>
            <td align="right">
              <a href="#" style="margin-left:12px;color:#52525b;text-decoration:none;font-size:13px;font-weight:600;">𝕏</a>
              <a href="#" style="margin-left:12px;color:#52525b;text-decoration:none;font-size:13px;font-weight:600;">f</a>
              <a href="#" style="margin-left:12px;color:#52525b;text-decoration:none;font-size:13px;font-weight:600;">◎</a>
            </td>
          </tr></table>
        </td></tr>

      </table>
    </td></tr>
  </table>
</body>
</html>
