<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Security alert — {{appName}}</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f5f7;padding:40px 0;">
    <tr>
      <td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.06),0 1px 4px rgba(0,0,0,0.04);">

          <!-- Header - Clean, minimal with subtle border -->
          <tr>
            <td style="background-color:#ffffff;padding:28px 40px 20px;text-align:center;border-bottom:1px solid #f0f0f0;">
              {{#if logoUrl}}
              <img src="{{logoUrl}}" alt="{{appName}}" width="36" style="display:block;margin:0 auto 8px;">
              {{/if}}
              <span style="color:#1a1a1a;font-size:16px;font-weight:500;letter-spacing:-0.2px;">{{appName}}</span>
            </td>
          </tr>

          <!-- Body - Professional, clean, with proper spacing -->
          <tr>
            <td style="padding:40px 48px 32px;">
              <!-- Security badge -->
              <div style="background:#f8f9fa;border-radius:40px;padding:6px 16px;display:inline-block;margin-bottom:24px;font-size:13px;color:#6b7280;border:1px solid #e5e7eb;">
                <span style="display:flex;align-items:center;gap:6px;">
                  <span style="display:inline-block;width:8px;height:8px;background:#b91c1c;border-radius:50%;"></span>
                  Security Alert
                </span>
              </div>

              <!-- Heading -->
              <h1 style="margin:0 0 12px;font-size:26px;color:#111827;font-weight:600;letter-spacing:-0.4px;">
                {{alertTitle}}
              </h1>
              
              <!-- Greeting -->
              <p style="margin:0 0 28px;font-size:16px;line-height:1.6;color:#4b5563;">
                Hi {{userName}},
              </p>

              <!-- Description -->
              <p style="margin:0 0 28px;font-size:16px;line-height:1.7;color:#4b5563;">
                We noticed a new sign-in to your {{appName}} account from a device we haven't seen before. 
                Here are the details:
              </p>

              <!-- Event Details - Clean card design -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 32px;border:1px solid #e5e7eb;background-color:#fafbfc;border-radius:8px;">
                <tr>
                  <td style="padding:20px 24px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:15px;color:#374151;">
                      {{#if eventType}}
                      <tr>
                        <td style="padding:8px 0;color:#6b7280;width:100px;font-size:13px;font-weight:500;letter-spacing:0.3px;text-transform:uppercase;">Event</td>
                        <td style="padding:8px 0;font-weight:500;color:#111827;">{{eventType}}</td>
                      </tr>
                      {{/if}}
                      {{#if timestamp}}
                      <tr>
                        <td style="padding:8px 0;color:#6b7280;width:100px;font-size:13px;font-weight:500;letter-spacing:0.3px;text-transform:uppercase;">Time</td>
                        <td style="padding:8px 0;color:#1f2937;">{{timestamp}}</td>
                      </tr>
                      {{/if}}
                      {{#if ipAddress}}
                      <tr>
                        <td style="padding:8px 0;color:#6b7280;width:100px;font-size:13px;font-weight:500;letter-spacing:0.3px;text-transform:uppercase;">IP Address</td>
                        <td style="padding:8px 0;font-family:'SF Mono',Menlo,monospace;font-size:14px;color:#1f2937;">{{ipAddress}}</td>
                      </tr>
                      {{/if}}
                      {{#if location}}
                      <tr>
                        <td style="padding:8px 0;color:#6b7280;width:100px;font-size:13px;font-weight:500;letter-spacing:0.3px;text-transform:uppercase;">Location</td>
                        <td style="padding:8px 0;color:#1f2937;">{{location}}</td>
                      </tr>
                      {{/if}}
                      {{#if deviceInfo}}
                      <tr>
                        <td style="padding:8px 0;color:#6b7280;width:100px;font-size:13px;font-weight:500;letter-spacing:0.3px;text-transform:uppercase;">Device</td>
                        <td style="padding:8px 0;color:#1f2937;">{{deviceInfo}}</td>
                      </tr>
                      {{/if}}
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Action buttons - Two options like major platforms -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 8px;">
                <tr>
                  <td align="center" style="padding-bottom:12px;">
                    {{#if secureAccountLink}}
                    <a href="{{secureAccountLink}}" style="display:inline-block;width:100%;padding:14px 0;font-size:16px;font-weight:500;color:#ffffff;text-decoration:none;border-radius:6px;background:#1a73e8;text-align:center;transition:background 0.2s;border:1px solid #1a73e8;">
                      Review activity
                    </a>
                    {{/if}}
                  </td>
                </tr>
              </table>

              <!-- Secondary link -->
              <p style="margin:16px 0 0;text-align:center;font-size:14px;color:#6b7280;">
                <a href="#" style="color:#6b7280;text-decoration:none;border-bottom:1px solid #d1d5db;">Not you? Secure your account</a>
              </p>

              <!-- Divider -->
              <div style="margin:32px 0 24px;height:1px;background:#f0f0f0;"></div>

              <!-- Additional info - Professional tone -->
              <p style="margin:0 0 8px;font-size:14px;line-height:1.6;color:#6b7280;">
                <span style="display:inline-block;margin-right:8px;">🛡️</span> 
                This email was sent to notify you about important security events.
              </p>
              
              <p style="margin:0;font-size:14px;line-height:1.6;color:#6b7280;">
                <span style="display:inline-block;margin-right:8px;">🔒</span> 
                For additional protection, we recommend <a href="#" style="color:#1a73e8;text-decoration:none;">enabling two-factor authentication</a>.
              </p>
            </td>
          </tr>

          <!-- Footer - Clean, minimal, legal -->
          <tr>
            <td style="background-color:#fafbfc;padding:20px 40px;text-align:center;border-top:1px solid #f0f0f0;">
              <p style="margin:0 0 4px;font-size:13px;color:#9ca3af;">
                &copy; {{year}} {{appName}}. All rights reserved.
              </p>
              <p style="margin:0 0 4px;font-size:13px;color:#9ca3af;">
                <a href="#" style="color:#9ca3af;text-decoration:none;">Privacy Policy</a> · 
                <a href="#" style="color:#9ca3af;text-decoration:none;">Terms of Service</a>
              </p>
              <p style="margin:8px 0 0;font-size:13px;color:#9ca3af;">
                Questions? Contact us at <a href="mailto:{{supportEmail}}" style="color:#1a73e8;text-decoration:none;">{{supportEmail}}</a>
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>